---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WorkGallery from '../components/WorkGallery.astro';
import { categories, services, works } from '../data/works';

const lineUrl = 'https://line.me/ti/p/fJpEGM2oB2';
const videoWorks = works.filter((work) => work.category === 'video');
---

<BaseLayout title="好聚設計｜聚焦品牌視覺 建立質感好形象" description="好聚設計專注於整合平面設計「電商」「社群」與多元視覺設計，提升品牌識別度與特色，建立一致的品牌好形象。">
  <SiteHeader />

  <main>
    <section class="hello-particles" id="hello-interactive" aria-label="HELLO 文字粒子互動">
      <h2 class="visually-hidden">HELLO!</h2>
      <canvas class="hello-particles__canvas" data-hello-particles aria-hidden="true"></canvas>
      <div class="hello-crosshair" data-hello-crosshair aria-hidden="true">
        <span class="hello-crosshair__line hello-crosshair__line--horizontal"></span>
        <span class="hello-crosshair__line hello-crosshair__line--vertical"></span>
        <span class="hello-crosshair__target"></span>
        <span class="hello-crosshair__readout" data-hello-coordinates></span>
      </div>
    </section>

    <section class="hero" id="home-hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <h1 id="hero-title" data-scroll-reveal-repeat aria-label="Gather. Design. Inspire. 聚焦品牌視覺｜建立質感好形象">
          <span class="hero__title-en" aria-hidden="true">
            <span class="hero__title-en-line" data-flip-heading>Gather. Design.</span>
            <span class="hero__title-en-line" data-flip-heading>Inspire.</span>
          </span>
          <span class="hero__title-zh" data-flip-heading aria-hidden="true">聚焦品牌視覺｜建立質感好形象</span>
        </h1>
        <p class="hero__description" data-scroll-reveal-repeat>多年廣告設計經驗，解決實際問題，專注整合平面設計｜主視覺｜電商｜社群｜多元視覺設計，提升品牌識別度與能見度，優化產品美學，建立有特色的品牌好形象。</p>
        <div class="hero__actions" data-scroll-reveal-repeat>
          <a class="button button--dark" href="/works/brand-key-visual/">設計案例</a>
          <a class="button button--footer" href="/game-ads/japanese-games/">遊戲類別</a>
        </div>
      </div>
      <div class="hero-art">
        <span class="hero-art__frame">
          <img src="/images/brand/haoju-business-card.jpg" alt="好聚設計品牌名片形象" fetchpriority="high" />
          <span class="hero-art__foil" aria-hidden="true"></span>
          <span class="hero-art__shine" aria-hidden="true"></span>
        </span>
      </div>
    </section>

    <section class="selected-section section-pad" id="services" aria-label="服務項目與作品">
      <div class="service-carousel" data-service-carousel>
        <div class="service-carousel__viewport">
          <div class="service-grid" data-carousel-track>
            {services.map((service) => (
                <a class="service-card" href={`/works/${service.category}/`}>
                  <span class="service-card__image">
                    {service.image && <img src={service.image} alt={service.alt} loading="lazy" decoding="async" />}
                  </span>
                  <span class="service-card__body">
                    <span class="service-card__title">{service.title}</span>
                    {service.examples && <span class="service-card__examples">{service.examples}</span>}
                  </span>
                </a>
            ))}
          </div>
        </div>
        <div class="selected-more-row">
          <button class="service-carousel__arrow service-carousel__arrow--prev" type="button" data-carousel-prev aria-label="上一個作品分類">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <a class="selected-more" data-scroll-reveal-repeat href="/works/brand-key-visual/">更多作品</a>
          <button class="service-carousel__arrow service-carousel__arrow--next" type="button" data-carousel-next aria-label="下一個作品分類">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="about-section section-pad" id="about" aria-labelledby="about-title">
      <div class="about-section__profile">
        <figure class="about-section__portrait" data-scroll-reveal>
          <img src="/images/brand/designer-portrait.png" alt="好聚設計設計師 hao 的個人形象照" loading="lazy" decoding="async" />
        </figure>
        <div class="about-section__intro" data-scroll-reveal-repeat>
          <h2 id="about-title">Hi，我是視覺設計師｜Geng Hao</h2>
          <p class="about-section__tagline">結合多年實務經驗，兼顧品牌與行銷並持續成長</p>
          <p> 2016年 投入視覺設計與遊戲美術相關工作，累積近 10 年設計領域經驗。從早期的插畫文創與遊戲視覺美術，延伸至電商視覺、社群行銷、品牌設計及 AI 輔助設計應用。擅長整合媒介與工具，將創意轉化為兼具美感、辨識度與商業價值的設計。</p>
        </div>
      </div>
      <div class="about-section__highlights">
        <article class="about-highlight" data-scroll-reveal>
          <h3 data-scroll-reveal-repeat>擁有 10 年設計經驗</h3>
          <p data-scroll-reveal-repeat>涵蓋插畫｜文創商品｜遊戲美術｜平面設計｜電商與廣告｜品牌視覺｜影像製作 等資歷，持續探索不同領域的創作可能。</p>
        </article>
        <article class="about-highlight" data-scroll-reveal>
          <h3 data-scroll-reveal-repeat>各式產業專案經歷</h3>
          <p data-scroll-reveal-repeat>依據不同品牌定位與市場需求，規劃合適的視覺呈現；承接包括電商、遊戲產業、科技教育、美食旅遊、寵物及醫美醫療等產業合作。</p>
        </article>
        <article class="about-highlight" data-scroll-reveal>
          <h3 data-scroll-reveal-repeat>多元領域視覺整合能力</h3>
          <p data-scroll-reveal-repeat>涵蓋品牌形象｜貼文｜平面廣告｜Logo｜型錄｜網站視覺｜插畫｜平面印刷｜商品修圖｜短影音剪輯後製，AI輔助視覺創作。</p>
        </article>
        <article class="about-highlight about-highlight--service" data-scroll-reveal>
          <h3 data-scroll-reveal-repeat>專業廣告主視覺｜讓活動一眼被看見</h3>
          <p data-scroll-reveal-repeat>從活動主題與商品特色出發，整理視覺重點，製作適用於電商、社群與廣告版位的主視覺素材。</p>
        </article>
        <article class="about-highlight about-highlight--service" data-scroll-reveal>
          <h3 data-scroll-reveal-repeat>品牌視覺整合｜讓風格統一呈現</h3>
          <p data-scroll-reveal-repeat>協助統整色彩、字體與版面風格，讓品牌從社群貼文、商品頁到印刷物都維持清楚一致的形象。</p>
        </article>
        <article class="about-highlight about-highlight--service" data-scroll-reveal>
          <h3 data-scroll-reveal-repeat>行銷素材延伸｜讓宣傳也有好品質</h3>
          <p data-scroll-reveal-repeat>將主視覺延伸成 Banner、貼文、商品圖與活動素材，讓不同平台能快速使用，也保有整體感。</p>
        </article>
      </div>
      <aside class="about-contact" aria-label="聯絡好聚設計">
        <p data-scroll-reveal-repeat>為每一個品牌打造一系列規劃，提供優質的設計服務</p>
        <a data-scroll-reveal-repeat href={lineUrl} target="_blank" rel="noreferrer">找我聊聊</a>
      </aside>
      {videoWorks.length > 0 && (
        <section class="about-video" aria-label="影片作品">
          <WorkGallery items={videoWorks} />
        </section>
      )}
      <a class="about-section__back-top" data-scroll-reveal-repeat href="/#home-hero">- BACK TO TOP -</a>
    </section>
  </main>

  <script>
    import { gsap } from 'gsap';

    const crosshairSections = document.querySelectorAll<HTMLElement>('.hello-particles');
    const fineCrosshairPointer = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

    const heroCard = document.querySelector<HTMLElement>('.hero-art');
    const heroCardFrame = heroCard?.querySelector<HTMLElement>('.hero-art__frame');
    if (heroCard && heroCardFrame && fineCrosshairPointer.matches) {
      const updateCardLight = (event: PointerEvent) => {
        if (event.pointerType !== 'mouse') return;
        const bounds = heroCardFrame.getBoundingClientRect();
        const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
        const y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
        const rotateX = (0.5 - y) * 26;
        const rotateY = (x - 0.5) * 26;
        const foilStrength = Math.min(1, Math.hypot(rotateX, rotateY) / 18);

        heroCard.classList.remove('is-resetting');
        heroCard.style.setProperty('--rx', `${rotateX}deg`);
        heroCard.style.setProperty('--ry', `${rotateY}deg`);
        heroCard.style.setProperty('--px', `${x * 100}%`);
        heroCard.style.setProperty('--py', `${y * 100}%`);
        heroCard.style.setProperty('--foil-opacity', `${0.04 + foilStrength * 0.34}`);
        heroCard.classList.add('is-tilting');
      };

      const resetCardLight = () => {
        heroCard.classList.add('is-resetting');
        heroCard.classList.remove('is-tilting');
        heroCard.style.setProperty('--rx', '0deg');
        heroCard.style.setProperty('--ry', '0deg');
        heroCard.style.setProperty('--px', '50%');
        heroCard.style.setProperty('--py', '50%');
        heroCard.style.setProperty('--foil-opacity', '0');
      };

      heroCard.addEventListener('pointermove', updateCardLight, { passive: true });
      heroCard.addEventListener('pointerleave', resetCardLight);
      heroCard.addEventListener('pointercancel', resetCardLight);
    }

    if (fineCrosshairPointer.matches) {
      crosshairSections.forEach((section) => {
        const crosshairLayer = section.querySelector<HTMLElement>('[data-hello-crosshair]');
        const coordinateReadout = crosshairLayer?.querySelector<HTMLElement>('[data-hello-coordinates]');
        if (!crosshairLayer || !coordinateReadout) return;

        section.addEventListener('pointermove', (event) => {
          if (event.pointerType !== 'mouse') return;
          const bounds = section.getBoundingClientRect();
          const x = Math.max(0, Math.min(bounds.width, event.clientX - bounds.left));
          const y = Math.max(0, Math.min(bounds.height, event.clientY - bounds.top));
          const xCoordinate = Math.round((x / bounds.width) * 1920).toString().padStart(4, '0');
          const yCoordinate = Math.round((y / bounds.height) * 1080).toString().padStart(4, '0');
          const labelWidth = coordinateReadout.offsetWidth;
          const labelHeight = coordinateReadout.offsetHeight;
          const labelX = Math.max(10, Math.min(bounds.width - labelWidth - 10, x + 18));
          const labelY = Math.max(10, Math.min(bounds.height - labelHeight - 10, y + 18));

          crosshairLayer.style.setProperty('--crosshair-x', `${x}px`);
          crosshairLayer.style.setProperty('--crosshair-y', `${y}px`);
          coordinateReadout.style.transform = `translate3d(${labelX}px, ${labelY}px, 0)`;
          coordinateReadout.textContent = `X ${xCoordinate}  Y ${yCoordinate}`;
          section.classList.add('is-crosshair-active');
          document.body.classList.add('is-crosshair-zone');
        }, { passive: true });
        section.addEventListener('pointerleave', () => {
          section.classList.remove('is-crosshair-active');
          document.body.classList.remove('is-crosshair-zone');
        });
      });
    }

    const particleCanvas = document.querySelector<HTMLCanvasElement>('[data-hello-particles]');
    const particleSection = particleCanvas?.closest<HTMLElement>('.hello-particles');
    const reducedParticleMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (particleCanvas && particleSection) {
      const context = particleCanvas.getContext('2d');
      let particles: { x: number; y: number; targetX: number; targetY: number; vx: number; vy: number }[] = [];
      let width = 0;
      let height = 0;
      let pointer = { x: -1000, y: -1000, active: false };
      let visible = false;
      let frame = 0;
      let running = false;
      const baseColor = '#ffffff';
      const accentColor = '#ffd1a0';

      const drawParticles = () => {
        if (!context) return;
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        context.clearRect(0, 0, width, height);
        const pointSize = width < 600 ? 2.2 : 2.6;
        const accent: typeof particles = [];
        const base: typeof particles = [];
        particles.forEach((particle) => {
          const displaced = Math.hypot(particle.x - particle.targetX, particle.y - particle.targetY) > 12;
          (displaced ? accent : base).push(particle);
        });
        context.fillStyle = baseColor;
        base.forEach(({ x, y }) => context.fillRect(x - pointSize / 2, y - pointSize / 2, pointSize, pointSize));
        context.fillStyle = accentColor;
        accent.forEach(({ x, y }) => context.fillRect(x - pointSize / 2, y - pointSize / 2, pointSize, pointSize));
      };

      const animate = () => {
        if (!context || !visible || running || reducedParticleMotion) return;
        running = true;
        const tick = () => {
          if (!visible || !context) {
            running = false;
            frame = 0;
            return;
          }
          let moving = false;
          const radius = width < 600 ? 92 : 132;
          particles.forEach((particle) => {
            let forceX = (particle.targetX - particle.x) * .075;
            let forceY = (particle.targetY - particle.y) * .075;
            if (pointer.active) {
              const dx = particle.x - pointer.x;
              const dy = particle.y - pointer.y;
              const distance = Math.hypot(dx, dy);
              if (distance < radius && distance > 0.1) {
                const force = ((radius - distance) / radius) * 2.3;
                forceX += (dx / distance) * force;
                forceY += (dy / distance) * force;
              }
            }
            particle.vx = (particle.vx + forceX) * .82;
            particle.vy = (particle.vy + forceY) * .82;
            particle.x += particle.vx;
            particle.y += particle.vy;
            if (Math.abs(particle.vx) + Math.abs(particle.vy) > .12 || Math.hypot(particle.x - particle.targetX, particle.y - particle.targetY) > 1.5) moving = true;
          });
          drawParticles();
          if (moving || pointer.active) frame = requestAnimationFrame(tick);
          else {
            running = false;
            frame = 0;
          }
        };
        frame = requestAnimationFrame(tick);
      };

      const rebuildParticles = () => {
        if (!context || !particleCanvas || !particleSection) return;
        const sectionStyles = getComputedStyle(particleSection);
        const horizontalPadding = parseFloat(sectionStyles.paddingLeft) + parseFloat(sectionStyles.paddingRight);
        width = particleSection.clientWidth - horizontalPadding;
        height = particleSection.clientHeight;
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        particleCanvas.width = Math.round(width * pixelRatio);
        particleCanvas.height = Math.round(height * pixelRatio);
        particleCanvas.style.width = `${width}px`;
        particleCanvas.style.height = `${height}px`;

        const sample = document.createElement('canvas');
        sample.width = Math.max(1, Math.floor(width));
        sample.height = Math.max(1, Math.floor(height));
        const sampleContext = sample.getContext('2d', { willReadFrequently: true });
        if (!sampleContext) return;
        const fontSize = Math.min(height * .68, width * .24, 190);
        sampleContext.font = `800 ${fontSize}px Arial, "Noto Sans TC", sans-serif`;
        sampleContext.textAlign = 'center';
        sampleContext.textBaseline = 'middle';
        sampleContext.fillStyle = '#fff';
        sampleContext.fillText('HELLO!', width / 2, height / 2);
        const pixels = sampleContext.getImageData(0, 0, sample.width, sample.height).data;
        const spacing = width < 600 ? 7 : 6;
        const targets: { x: number; y: number }[] = [];
        let minTargetX = sample.width;
        let maxTargetX = 0;
        for (let y = 0; y < sample.height; y += spacing) {
          for (let x = 0; x < sample.width; x += spacing) {
            if (pixels[(y * sample.width + x) * 4 + 3] > 100) {
              targets.push({ x, y });
              minTargetX = Math.min(minTargetX, x);
              maxTargetX = Math.max(maxTargetX, x);
            }
          }
        }
        const opticalCenterOffset = width / 2 - (minTargetX + maxTargetX) / 2;
        particles = targets.map(({ x, y }) => ({
          x: reducedParticleMotion ? x + opticalCenterOffset : Math.random() * width,
          y: reducedParticleMotion ? y : Math.random() * height,
          targetX: x + opticalCenterOffset,
          targetY: y,
          vx: 0,
          vy: 0,
        }));
        drawParticles();
        animate();
      };

      particleCanvas.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse' || reducedParticleMotion) return;
        const bounds = particleCanvas.getBoundingClientRect();
        pointer = { x: event.clientX - bounds.left, y: event.clientY - bounds.top, active: true };
        animate();
      });
      particleCanvas.addEventListener('pointerleave', () => {
        pointer = { x: -1000, y: -1000, active: false };
        animate();
      });

      if ('IntersectionObserver' in window) {
        const particleObserver = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          if (visible) animate();
          else if (frame) {
            cancelAnimationFrame(frame);
            frame = 0;
            running = false;
          }
        }, { threshold: .1 });
        particleObserver.observe(particleSection);
      } else {
        visible = true;
      }
      new ResizeObserver(rebuildParticles).observe(particleSection);
      document.fonts?.ready.then(rebuildParticles);
      rebuildParticles();
    }

    const motionAllowed = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    document.querySelectorAll<HTMLElement>('[data-service-carousel]').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!track || !previous || !next) return;

      const originals = Array.from(track.children).filter((card): card is HTMLElement => card instanceof HTMLElement && card.classList.contains('service-card'));
      if (originals.length < 5) return;

      const desktopCarousel = window.matchMedia('(min-width: 961px)');
      let isInitialized = false;
      let currentIndex = 0;
      let loopCount = 0;
      let queuedMoves = 0;
      let isMoving = false;
      let autoplayTimer: number | undefined;
      let pointerInside = false;
      let focusInside = false;

      const stopAutoplay = () => {
        if (autoplayTimer !== undefined) window.clearInterval(autoplayTimer);
        autoplayTimer = undefined;
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (!desktopCarousel.matches || !isInitialized || !motionAllowed || document.hidden || pointerInside || focusInside) return;
        autoplayTimer = window.setInterval(() => stepCarousel(1), 5000);
      };

      const resetAutoplay = () => {
        stopAutoplay();
        startAutoplay();
      };

      const cloneCard = (card: HTMLElement) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.dataset.carouselClone = 'true';
        clone.setAttribute('aria-hidden', 'true');
        clone.tabIndex = -1;
        clone.querySelectorAll<HTMLElement>('[data-scroll-reveal-repeat], .scroll-reveal, .is-visible, .is-resetting').forEach((item) => {
          item.removeAttribute('data-scroll-reveal-repeat');
          item.classList.remove('scroll-reveal', 'is-visible', 'is-resetting');
        });
        return clone;
      };

      const moveTrack = () => {
        if (!isInitialized) return;
        const firstCard = track.children[0] as HTMLElement;
        const cardWidth = firstCard.getBoundingClientRect().width;
        const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
        track.style.transform = `translate3d(${-currentIndex * (cardWidth + gap)}px, 0, 0)`;
      };

      const normalizeLoopPosition = () => {
        if (!isInitialized) return;
        const firstRealIndex = loopCount;
        const afterRealIndex = firstRealIndex + originals.length;
        let normalizedIndex = currentIndex;
        if (currentIndex >= afterRealIndex) normalizedIndex = firstRealIndex + ((currentIndex - firstRealIndex) % originals.length);
        else if (currentIndex < firstRealIndex) normalizedIndex = firstRealIndex + ((currentIndex - firstRealIndex) % originals.length + originals.length) % originals.length;
        if (normalizedIndex === currentIndex) return;

        currentIndex = normalizedIndex;
        track.style.transition = 'none';
        moveTrack();
        void track.offsetWidth;
        track.style.transition = '';
      };

      const stepCarousel = (direction: number) => {
        if (!isInitialized) return;
        if (isMoving) {
          queuedMoves += direction;
          return;
        }
        currentIndex += direction;
        isMoving = true;
        moveTrack();
      };

      track.addEventListener('transitionend', (event) => {
        if (event.target !== track || event.propertyName !== 'transform' || !isMoving) return;
        normalizeLoopPosition();
        isMoving = false;
        if (queuedMoves !== 0) {
          const direction = Math.sign(queuedMoves);
          queuedMoves -= direction;
          stepCarousel(direction);
        }
      });
      previous.addEventListener('click', () => {
        stepCarousel(-1);
        resetAutoplay();
      });
      next.addEventListener('click', () => {
        stepCarousel(1);
        resetAutoplay();
      });

      carousel.addEventListener('pointerenter', () => {
        pointerInside = true;
        stopAutoplay();
      });
      carousel.addEventListener('pointerleave', () => {
        pointerInside = false;
        startAutoplay();
      });
      carousel.addEventListener('focusin', () => {
        focusInside = true;
        stopAutoplay();
      });
      carousel.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget)) return;
        focusInside = false;
        startAutoplay();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });

      const setCarouselMode = () => {
        if (desktopCarousel.matches && !isInitialized) {
          loopCount = Math.min(4, originals.length - 1);
          track.prepend(...originals.slice(-loopCount).map(cloneCard));
          track.append(...originals.slice(0, loopCount).map(cloneCard));
          currentIndex = loopCount;
          isInitialized = true;
          track.style.transition = 'none';
          moveTrack();
          void track.offsetWidth;
          track.style.transition = '';
          startAutoplay();
        } else if (!desktopCarousel.matches && isInitialized) {
          stopAutoplay();
          track.querySelectorAll('[data-carousel-clone]').forEach((clone) => clone.remove());
          track.style.transform = '';
          isInitialized = false;
        }
      };

      desktopCarousel.addEventListener('change', setCarouselMode);
      window.addEventListener('resize', () => {
        if (!isInitialized) return;
        isMoving = false;
        queuedMoves = 0;
        track.style.transition = 'none';
        moveTrack();
        void track.offsetWidth;
        track.style.transition = '';
      }, { passive: true });
      setCarouselMode();
    });

    const moreWorksButton = document.querySelector<HTMLAnchorElement>('.selected-more');
    if (moreWorksButton && motionAllowed) {
      const replayJelly = () => {
        moreWorksButton.classList.remove('is-jelly');
        void moreWorksButton.offsetWidth;
        moreWorksButton.classList.add('is-jelly');
      };
      moreWorksButton.addEventListener('pointerenter', replayJelly);
      moreWorksButton.addEventListener('click', replayJelly);
      moreWorksButton.addEventListener('animationend', () => moreWorksButton.classList.remove('is-jelly'));
    }

  </script>

  <SiteFooter />
</BaseLayout>
