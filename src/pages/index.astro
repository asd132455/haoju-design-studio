---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { categories, services, works } from '../data/works';

const lineUrl = 'https://line.me/ti/p/fJpEGM2oB2';
---

<BaseLayout title="好聚設計｜聚焦品牌視覺，讓好印象聚在一起" description="好聚設計整合電商、社群與多元視覺設計，展現品牌質感與特色，建立一致的品牌形象。">
  <header class="site-header" id="top">
    <a class="brand-lockup" href="/" aria-label="好聚設計首頁">
      <img src="/images/brand/haoju-avatar.jpg" alt="" width="64" height="64" />
      <span class="brand-lockup__words"><strong>好聚設計</strong><small>HAOJU DESIGN</small></span>
    </a>
    <nav class="main-nav" aria-label="主要導覽">
      <a href="/#home-hero">關於好聚</a>
      <a href="/works/ecommerce/">作品案例</a>
      <a class="main-nav__contact" href={lineUrl} target="_blank" rel="noreferrer">LINE 聯絡 <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero" id="home-hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <h1 id="hero-title">聚焦品牌視覺，<br /><span>讓好印象聚在一起。</span></h1>
        <p class="hero__description">整合電商、社群與多元視覺設計，展現品牌質感與特色，建立一致的品牌形象。</p>
        <div class="hero__actions">
          <a class="button button--dark" href={lineUrl} target="_blank" rel="noreferrer">聊聊品牌合作 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/works/ecommerce/">看看作品 <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-art">
        <span class="hero-art__frame">
          <img src="/images/brand/haoju-business-card.jpg" alt="好聚設計品牌名片形象" fetchpriority="high" />
        </span>
      </div>
    </section>

    <section class="selected-section section-pad" id="services" aria-label="服務項目與作品">
      <div class="service-grid">
        {services.map((service) => {
          const category = categories.find((item) => item.slug === service.category)!;
          return (
            <a class="service-card" data-scroll-reveal href={`/works/${service.category}/`}>
              <span class="service-card__image"><img src={service.image} alt={service.alt} loading="lazy" decoding="async" /></span>
              <span class="service-card__body">
                <span class="service-card__title">{service.title}</span>
                <span class="service-card__descriptor">{service.descriptor}</span>
                <span class="service-card__examples">{service.examples}</span>
              </span>
              <span class="visually-hidden">{category.description}</span>
            </a>
          );
        })}
      </div>
      <a class="selected-more" href="/works/ecommerce/">更多作品</a>
    </section>

    <section class="about-section section-pad" id="about" aria-labelledby="about-title" data-scroll-reveal>
      <div class="about-section__heading"><h2 id="about-title">好聚設計，<br />為品牌好好聚焦。</h2></div>
      <div class="about-section__body">
        <p class="about-section__lead">讓品牌的每一面，<br /><span>都被好好看見。</span></p>
        <p>好聚設計整合電商、社群與多元視覺設計規劃，從品牌特質出發，呈現專屬的質感與特色。讓每一次的品牌露出彼此呼應，慢慢累積一致、清楚的好印象。</p>
        <div class="designer-note">
          <img src="/images/brand/haoju-avatar.jpg" alt="好聚設計標誌" width="76" height="76" loading="lazy" />
          <div><strong>設計師簡介</strong><span>姓名與個人介紹將於後續補上</span></div>
        </div>
      </div>
      <a class="about-section__back-top" href="/#home-hero">- BACK TO TOP -</a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
