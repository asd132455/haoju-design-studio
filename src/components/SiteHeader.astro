---
const lineUrl = 'https://line.me/ti/p/fJpEGM2oB2';
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/';
const isDesignPage = currentPath.startsWith('/works/');
const isGameAdsPage = currentPath.startsWith('/game-ads/');
---

<header class="site-header" id="top">
  <a class="brand-lockup" href="/" aria-label="好聚設計首頁">
    <img src="/images/brand/haoju-avatar.jpg" alt="" width="64" height="64" />
    <span class="brand-lockup__words"><strong>好聚設計</strong><small>HAOJU DESIGN</small></span>
  </a>
  <nav class="main-nav" aria-label="主要導覽">
    <a href="/#hello-interactive" data-about-link aria-current={isHomePage ? 'page' : undefined}>關於好聚</a>
    <a href="/works/brand-key-visual/" aria-current={isDesignPage ? 'page' : undefined}>設計作品</a>
    <a href="/game-ads/korean-games/" aria-current={isGameAdsPage ? 'page' : undefined}>遊戲廣告</a>
    <a class="main-nav__contact" href={lineUrl} target="_blank" rel="noreferrer">LINE 聊聊 <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<script>
  const aboutLink = document.querySelector<HTMLAnchorElement>('[data-about-link]');

  aboutLink?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (window.matchMedia('(max-width: 900px)').matches) {
      event.preventDefault();
      window.location.href = '/#home-hero';
    }
  });
</script>
