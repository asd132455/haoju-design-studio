---
import type { WorkItem } from '../data/works';

interface Props {
  items: WorkItem[];
  activeCategory?: string;
}

const { items, activeCategory } = Astro.props;
let visibleIndex = 0;
---

<div class="work-grid">
  {items.map((work) => {
    const isVisible = !activeCategory || work.category === activeCategory;
    const orderInActive = isVisible ? visibleIndex++ : -1;
    return (
      <article class="work-card" data-scroll-reveal-repeat data-work-category={work.category} hidden={activeCategory ? !isVisible : undefined}>
        <button
          class:list={['work-card__open', work.videoUrl && 'work-card__open--video']}
          type="button"
          data-lightbox-open
          data-image={work.image}
          data-alt={work.alt}
          data-category={work.category}
          data-video-embed={work.videoUrl}
          aria-label={work.videoUrl ? `播放影片：${work.title}` : `放大觀看：${work.title}`}
        >
          <span class:list={['work-card__image-wrap', work.videoUrl && 'work-card__image-wrap--video']}>
            <img
              src={work.image}
              alt={work.alt}
              loading={isVisible && orderInActive < 8 ? 'eager' : 'lazy'}
              fetchpriority={isVisible && orderInActive < 4 ? 'high' : undefined}
              decoding="async"
            />
            {work.videoUrl ? (
              <span class="work-card__play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8.5 6.5 18 12l-9.5 5.5z" /></svg>
              </span>
            ) : (
              <span class="work-card__zoom" aria-hidden="true">↗</span>
            )}
          </span>
        </button>
      </article>
    );
  })}
</div>

<dialog class="lightbox" data-lightbox aria-label="作品放大檢視">
  <div class="lightbox__topline">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="關閉作品放大檢視"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="上一張作品"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg></button>
  <div class="lightbox__image-wrap">
    <img data-lightbox-image src="" alt="" />
  </div>
  <div class="lightbox__video-wrap" data-lightbox-video-wrap hidden>
    <div class="lightbox__video-frame">
      <iframe
        data-lightbox-iframe
        title="影片播放"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="下一張作品"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg></button>
  <p class="lightbox__hint">點兩下或雙指縮放，左右滑動切換作品</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  const previousButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const imageWrap = dialog?.querySelector<HTMLElement>('.lightbox__image-wrap');
  const videoWrap = dialog?.querySelector<HTMLElement>('[data-lightbox-video-wrap]');
  const videoIframe = dialog?.querySelector<HTMLIFrameElement>('[data-lightbox-iframe]');
  const studioCursor = document.querySelector<HTMLElement>('.studio-cursor');
  const allCards = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]')];
  let cards = [...allCards];
  let currentIndex = 0;
  let imageRequest = 0;
  let closeTimer = 0;
  let closePending = false;
  let scale = 1;
  const pointers = new Map<number, { x: number; y: number }>();
  let gestureStart = { x: 0, y: 0 };
  let startDistance = 0;
  let startScale = 1;
  let pan = { x: 0, y: 0 };
  let startPan = { x: 0, y: 0 };
  let startScrollTop = 0;

  const resetScale = () => {
    scale = 1;
    pan = { x: 0, y: 0 };
    image?.style.setProperty('transform', 'translate(0px, 0px) scale(1)');
  };

  const showImage = (index: number) => {
    if (!image || !cards.length) return;
    currentIndex = (index + cards.length) % cards.length;
    const button = cards[currentIndex];
    const requestId = ++imageRequest;
    const videoEmbed = button.dataset.videoEmbed ?? '';
    dialog?.setAttribute('data-category', button.dataset.category ?? '');
    resetScale();
    imageWrap?.scrollTo({ top: 0, left: 0 });

    if (videoEmbed && videoWrap && videoIframe && imageWrap) {
      imageWrap.hidden = true;
      image.hidden = true;
      image.removeAttribute('src');
      videoWrap.hidden = false;
      videoIframe.src = videoEmbed;
      videoIframe.title = button.dataset.alt || '影片播放';
      dialog?.classList.add('is-video');
      return;
    }

    if (videoWrap && videoIframe && imageWrap) {
      videoIframe.src = '';
      videoWrap.hidden = true;
      imageWrap.hidden = false;
      dialog?.classList.remove('is-video');
    }

    const nextImageSource = button.dataset.image ?? '';
    if (!image.hasAttribute('src')) image.hidden = true;
    image.alt = button.dataset.alt ?? '';

    const preload = new Image();
    const revealLoadedImage = () => {
      if (requestId === imageRequest) image.hidden = false;
    };
    preload.onload = () => {
      if (requestId !== imageRequest) return;
      image.src = nextImageSource;
      revealLoadedImage();
    };
    preload.src = nextImageSource;
    if (preload.complete && preload.naturalWidth > 0) {
      image.src = nextImageSource;
      revealLoadedImage();
    }
  };

  const requestClose = () => {
    if (!dialog?.open || closePending) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      dialog.close();
      return;
    }
    closePending = true;
    dialog.classList.add('is-closing');
    closeTimer = window.setTimeout(() => dialog.close(), 280);
  };

  if (dialog && image && closeButton && previousButton && nextButton && imageWrap) {
    allCards.forEach((button) => {
      button.addEventListener('click', () => {
        cards = allCards.filter((card) => !card.closest<HTMLElement>('[data-work-category]')?.hidden);
        const index = cards.indexOf(button);
        if (index < 0) return;
        window.clearTimeout(closeTimer);
        closePending = false;
        dialog.classList.remove('is-closing');
        showImage(index);
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        if (scrollbarWidth > 0) document.documentElement.style.paddingRight = `${scrollbarWidth}px`;
        if (studioCursor) {
          dialog.append(studioCursor);
          studioCursor.classList.add('is-in-lightbox');
          dialog.classList.add('has-studio-cursor');
        }
        closeButton.focus();
      });
    });

    previousButton.addEventListener('click', () => showImage(currentIndex - 1));
    nextButton.addEventListener('click', () => showImage(currentIndex + 1));
    closeButton.addEventListener('click', requestClose);
    let suppressClickUntil = 0;
    dialog.addEventListener('click', (event) => {
      if (performance.now() < suppressClickUntil) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('button') || target.closest('.lightbox__video-frame')) return;
      const clickedImage = target.closest<HTMLImageElement>('img[data-lightbox-image]')
        ?? (target.closest('.lightbox__image-wrap') ? image : null);
      if (clickedImage && image.naturalWidth > 0 && image.naturalHeight > 0) {
        const bounds = image.getBoundingClientRect();
        const imageRatio = image.naturalWidth / image.naturalHeight;
        const boxRatio = bounds.width / bounds.height;
        let visibleImageBounds = bounds;

        if (dialog.dataset.category !== 'sales-page') {
          if (imageRatio > boxRatio) {
            const visibleHeight = bounds.width / imageRatio;
            visibleImageBounds = new DOMRect(bounds.left, bounds.top + (bounds.height - visibleHeight) / 2, bounds.width, visibleHeight);
          } else {
            const visibleWidth = bounds.height * imageRatio;
            visibleImageBounds = new DOMRect(bounds.left + (bounds.width - visibleWidth) / 2, bounds.top, visibleWidth, bounds.height);
          }
        }

        const insideImage =
          event.clientX >= visibleImageBounds.left &&
          event.clientX <= visibleImageBounds.right &&
          event.clientY >= visibleImageBounds.top &&
          event.clientY <= visibleImageBounds.bottom;
        if (insideImage) return;
      }
      requestClose();
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      requestClose();
    });
    dialog.addEventListener('close', () => {
      window.clearTimeout(closeTimer);
      closePending = false;
      dialog.classList.remove('is-closing');
      document.documentElement.style.overflow = '';
      document.documentElement.style.paddingRight = '';
      if (studioCursor) {
        document.body.append(studioCursor);
        studioCursor.classList.remove('is-in-lightbox');
        dialog.classList.remove('has-studio-cursor');
      }
      imageRequest++;
      image.hidden = true;
      image.removeAttribute('src');
      if (videoIframe) videoIframe.src = '';
      if (videoWrap) videoWrap.hidden = true;
      imageWrap.hidden = false;
      dialog.classList.remove('is-video');
      resetScale();
    });

    const distanceBetween = (points: { x: number; y: number }[]) => Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
    const midpointBetween = (points: { x: number; y: number }[]) => ({
      x: (points[0].x + points[1].x) / 2,
      y: (points[0].y + points[1].y) / 2,
    });
    const getClampBounds = (targetScale: number) => {
      const wrapRect = imageWrap.getBoundingClientRect();
      let baseWidth = wrapRect.width;
      let baseHeight = wrapRect.height;
      if (dialog.dataset.category === 'sales-page') {
        baseWidth = image.offsetWidth || wrapRect.width;
        baseHeight = image.offsetHeight || wrapRect.height;
      } else if (image.naturalWidth > 0 && image.naturalHeight > 0 && wrapRect.width > 0 && wrapRect.height > 0) {
        const naturalRatio = image.naturalWidth / image.naturalHeight;
        const wrapRatio = wrapRect.width / wrapRect.height;
        if (naturalRatio > wrapRatio) {
          baseWidth = wrapRect.width;
          baseHeight = wrapRect.width / naturalRatio;
        } else {
          baseHeight = wrapRect.height;
          baseWidth = wrapRect.height * naturalRatio;
        }
      }
      return {
        wrapRect,
        maxPanX: Math.max(0, (baseWidth * targetScale - wrapRect.width) / 2),
        maxPanY: Math.max(0, (baseHeight * targetScale - wrapRect.height) / 2),
      };
    };
    const clampPan = (x: number, y: number, targetScale: number) => {
      if (targetScale <= 1.01) return { x: 0, y: 0 };
      const { maxPanX, maxPanY } = getClampBounds(targetScale);
      return {
        x: Math.max(-maxPanX, Math.min(maxPanX, x)),
        y: Math.max(-maxPanY, Math.min(maxPanY, y)),
      };
    };
    const renderTransform = (animate = false) => {
      image.classList.toggle('is-gesturing', !animate);
      image.style.transform = `translate3d(${pan.x}px, ${pan.y}px, 0) scale(${scale})`;
    };

    let startMidpoint = { x: 0, y: 0 };
    let didPinch = false;
    let didMove = false;
    let lastTapTime = 0;
    let lastTapPoint = { x: 0, y: 0 };

    dialog.addEventListener('touchmove', (event) => {
      if (!dialog.open || dialog.classList.contains('is-video')) return;
      if (event.touches.length >= 2 || dialog.dataset.category !== 'sales-page') {
        event.preventDefault();
      }
    }, { passive: false });
    dialog.addEventListener('gesturestart', (event) => event.preventDefault());
    dialog.addEventListener('gesturechange', (event) => event.preventDefault());

    imageWrap.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      imageWrap.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 1) {
        didPinch = false;
        didMove = false;
        gestureStart = { x: event.clientX, y: event.clientY };
        startPan = { ...pan };
        startScrollTop = imageWrap.scrollTop;
      } else if (pointers.size === 2) {
        const points = [...pointers.values()];
        didPinch = true;
        didMove = true;
        startDistance = distanceBetween(points);
        startMidpoint = midpointBetween(points);
        startScale = scale;
        startPan = { ...pan };
      }
    });
    imageWrap.addEventListener('pointermove', (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size >= 2 && startDistance > 0) {
        const points = [...pointers.values()].slice(0, 2);
        const nextScale = Math.max(1, Math.min(4, startScale * distanceBetween(points) / startDistance));
        const currentMidpoint = midpointBetween(points);
        const { wrapRect } = getClampBounds(nextScale);
        const centerX = wrapRect.left + wrapRect.width / 2;
        const centerY = wrapRect.top + wrapRect.height / 2;
        const offsetX = startMidpoint.x - centerX;
        const offsetY = startMidpoint.y - centerY;
        const ratio = nextScale / startScale;
        const rawX = (startPan.x - offsetX) * ratio + offsetX + (currentMidpoint.x - startMidpoint.x);
        const rawY = (startPan.y - offsetY) * ratio + offsetY + (currentMidpoint.y - startMidpoint.y);
        scale = nextScale <= 1.01 ? 1 : nextScale;
        pan = clampPan(rawX, rawY, scale);
        renderTransform(false);
        return;
      }
      if (pointers.size !== 1) return;
      const dx = event.clientX - gestureStart.x;
      const dy = event.clientY - gestureStart.y;
      if (Math.hypot(dx, dy) > 8) didMove = true;
      if (scale > 1.01) {
        pan = clampPan(startPan.x + dx, startPan.y + dy, scale);
        renderTransform(false);
      } else if (dialog.dataset.category === 'sales-page') {
        imageWrap.scrollTop = startScrollTop - dy;
      }
    });
    const endPointer = (event: PointerEvent) => {
      if (!pointers.has(event.pointerId)) return;
      const wasSinglePointer = pointers.size === 1;
      pointers.delete(event.pointerId);

      if (pointers.size === 1) {
        const [remaining] = [...pointers.values()];
        gestureStart = { x: remaining.x, y: remaining.y };
        startPan = { ...pan };
        startDistance = 0;
        return;
      }

      if (pointers.size < 2) startDistance = 0;

      if (didPinch || didMove) {
        suppressClickUntil = performance.now() + 320;
      }

      if (wasSinglePointer && !didPinch && scale <= 1.01) {
        const dx = event.clientX - gestureStart.x;
        const dy = event.clientY - gestureStart.y;
        if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.25) {
          showImage(currentIndex + (dx < 0 ? 1 : -1));
          lastTapTime = 0;
          return;
        }
      }

      if (event.type === 'pointerup' && wasSinglePointer && !didPinch && !didMove && !dialog.classList.contains('is-video')) {
        const now = performance.now();
        const isDoubleTap = now - lastTapTime < 320 && Math.hypot(event.clientX - lastTapPoint.x, event.clientY - lastTapPoint.y) < 36;
        if (isDoubleTap) {
          lastTapTime = 0;
          suppressClickUntil = now + 400;
          if (scale > 1.05) {
            scale = 1;
            pan = { x: 0, y: 0 };
          } else {
            const targetScale = 2.5;
            const { wrapRect } = getClampBounds(targetScale);
            const offsetX = event.clientX - (wrapRect.left + wrapRect.width / 2);
            const offsetY = event.clientY - (wrapRect.top + wrapRect.height / 2);
            scale = targetScale;
            pan = clampPan(-offsetX * (targetScale - 1), -offsetY * (targetScale - 1), targetScale);
          }
          renderTransform(true);
        } else {
          lastTapTime = now;
          lastTapPoint = { x: event.clientX, y: event.clientY };
        }
      }
    };
    imageWrap.addEventListener('pointerup', endPointer);
    imageWrap.addEventListener('pointercancel', endPointer);
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
      if (event.key === 'ArrowRight') showImage(currentIndex + 1);
    });
  }
</script>
