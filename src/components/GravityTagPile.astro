---
import { gameAdCategories } from '../data/game-ads';
---

<section class="gravity-tags" data-gravity-tags data-labels={[...gameAdCategories.map((category) => category.title), '插畫', '品牌設計', 'UI／UX'].join('、')} aria-label="遊戲廣告分類互動標籤">
  <canvas data-gravity-canvas aria-hidden="true"></canvas>
  <div class="hello-crosshair" data-gravity-crosshair aria-hidden="true">
    <span class="hello-crosshair__line hello-crosshair__line--horizontal"></span>
    <span class="hello-crosshair__line hello-crosshair__line--vertical"></span>
    <span class="hello-crosshair__target"></span>
    <span class="hello-crosshair__readout" data-gravity-coordinates></span>
  </div>
</section>

<script>
  type Tag = {
    text: string;
    width: number;
    height: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    angle: number;
    renderAngle: number;
    spin: number;
    born: number;
    dragging: boolean;
  };

  const stages = document.querySelectorAll<HTMLElement>('[data-gravity-tags]');

  stages.forEach((stage) => {
    const canvas = stage.querySelector<HTMLCanvasElement>('[data-gravity-canvas]');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compactTags = window.matchMedia('(max-width: 640px)');
    const labels = (stage.dataset.labels ?? '').split('、').filter(Boolean);
    const crosshairLayer = stage.querySelector<HTMLElement>('[data-gravity-crosshair]');
    const coordinateReadout = stage.querySelector<HTMLElement>('[data-gravity-coordinates]');
    const crosshairPointer = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    const tags: Tag[] = [];
    const pointer = { x: 0, y: 0, lastX: 0, lastY: 0, lastTime: 0, offsetX: 0, offsetY: 0 };
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let dragging: Tag | null = null;
    let frame = 0;
    let lastFrame = 0;
    let visible = false;
    let idleTimer = 0;

    const tagFontSize = () => compactTags.matches ? 13 : 17;
    const measure = () => {
      const fontSize = tagFontSize();
      context.font = `500 ${fontSize}px "Noto Sans TC", sans-serif`;
      const horizontalPadding = compactTags.matches ? 41 : 56;
      const tagHeight = compactTags.matches ? 43 : 60;
      return labels.map((text) => ({ text, width: Math.ceil(context.measureText(text).width + horizontalPadding), height: tagHeight }));
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      context.font = `500 ${tagFontSize()}px "Noto Sans TC", sans-serif`;
      tags.length = 0;
      const spawnStart = performance.now() / 1000;
      measure().forEach((item, index) => {
        const x = Math.max(item.width / 2 + 5, Math.random() * (width - item.width - 10) + item.width / 2);
        const columns = Math.max(2, Math.floor(width / 150));
        const column = index % columns;
        const initialAngle = reduceMotion ? 0 : (Math.random() - .5) * .18;
        tags.push({
          ...item,
          x: reduceMotion ? (column + .5) * width / columns : x,
          y: reduceMotion ? 54 + Math.floor(index / columns) * 58 : -item.height - index * 42,
          vx: 0,
          vy: reduceMotion ? 0 : 15 + Math.random() * 40,
          angle: initialAngle,
          renderAngle: initialAngle,
          spin: reduceMotion ? 0 : (Math.random() - .5) * .7,
          born: spawnStart + index * .13,
          dragging: false,
        });
      });
      if (reduceMotion) draw(1);
    };

    const pillPath = (x: number, y: number, w: number, h: number) => {
      const radius = h / 2;
      context.beginPath();
      context.moveTo(x + radius, y);
      context.lineTo(x + w - radius, y);
      context.arc(x + w - radius, y + radius, radius, -Math.PI / 2, Math.PI / 2);
      context.lineTo(x + radius, y + h);
      context.arc(x + radius, y + radius, radius, Math.PI / 2, Math.PI * 1.5);
      context.closePath();
    };

    const draw = (time: number) => {
      context.clearRect(0, 0, width, height);
      tags.forEach((tag, index) => {
        if (!reduceMotion && time < tag.born) return;
        context.save();
        context.translate(tag.x, tag.y);
        context.rotate(tag.renderAngle);
        pillPath(-tag.width / 2, -tag.height / 2, tag.width, tag.height);
        const style = index % 3;
        if (style === 0) {
          context.fillStyle = '#63927b';
          context.fill();
          context.fillStyle = '#fff';
        } else if (style === 1) {
          context.fillStyle = '#fff';
          context.fill();
          context.fillStyle = '#dbb695';
        } else {
          context.fillStyle = '#c48962';
          context.fill();
          context.fillStyle = '#fff';
        }
        context.font = `500 ${tagFontSize()}px "Noto Sans TC", sans-serif`;
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        context.fillText(tag.text, 0, .5);
        context.restore();
      });
    };

    const boxHalfHeight = (tag: Tag) => (Math.abs(Math.sin(tag.angle)) * tag.width + Math.abs(Math.cos(tag.angle)) * tag.height) / 2;

    const step = (now: number) => {
      if (!visible || reduceMotion) return;
      const dt = Math.min((now - (lastFrame || now)) / 1000, 1 / 30);
      lastFrame = now;

      tags.forEach((tag) => {
        if (tag.dragging || now / 1000 < tag.born) return;
        tag.vy += 1050 * dt;
        tag.x += tag.vx * dt;
        tag.y += tag.vy * dt;
        tag.angle += tag.spin * dt;
        const angleDifference = Math.atan2(Math.sin(tag.angle - tag.renderAngle), Math.cos(tag.angle - tag.renderAngle));
        tag.renderAngle += angleDifference * (1 - Math.exp(-20 * dt));
        tag.vx *= Math.pow(.994, dt * 60);
        tag.spin *= Math.pow(.985, dt * 60);

        const halfWidth = (Math.abs(Math.cos(tag.angle)) * tag.width + Math.abs(Math.sin(tag.angle)) * tag.height) / 2;
        const halfHeight = boxHalfHeight(tag);
        if (tag.x < halfWidth) { tag.x = halfWidth; tag.vx = Math.abs(tag.vx) * .42; tag.spin *= -.72; }
        if (tag.x > width - halfWidth) { tag.x = width - halfWidth; tag.vx = -Math.abs(tag.vx) * .42; tag.spin *= -.72; }
        if (tag.y > height - halfHeight) {
          tag.y = height - halfHeight;
          tag.vy = tag.vy > 85 ? -tag.vy * .25 : 0;
          tag.vx *= .82;
          tag.angle *= Math.exp(-4.5 * dt);
          tag.spin *= Math.exp(-5.2 * dt);
        } else if (Math.abs(tag.vx) < 120 && Math.abs(tag.vy) < 85) {
          const supported = tags.some((other) => other !== tag
            && other.y > tag.y
            && Math.abs(other.x - tag.x) < (other.width + tag.width) / 2
            && Math.abs((other.y - other.height / 2) - (tag.y + halfHeight)) < 8);
          if (supported) {
            tag.angle *= Math.exp(-4.5 * dt);
            tag.spin *= Math.exp(-5.2 * dt);
          }
        }
      });

      for (let i = 0; i < tags.length; i++) {
        const a = tags[i];
        if (a.dragging || now / 1000 < a.born) continue;
        for (let j = i + 1; j < tags.length; j++) {
          const b = tags[j];
          if (b.dragging || now / 1000 < b.born) continue;
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const overlapX = (a.width + b.width) / 2 - Math.abs(dx);
          const overlapY = (a.height + b.height) / 2 - Math.abs(dy);
          if (overlapX <= 0 || overlapY <= 0) continue;
          if (overlapX < overlapY) {
            const direction = dx < 0 ? -1 : 1;
            a.x -= direction * overlapX * .52;
            b.x += direction * overlapX * .48;
            const relative = (b.vx - a.vx) * direction;
            if (relative < 0) { const impulse = -(1.38 * relative) / 2; a.vx -= impulse * direction; b.vx += impulse * direction; }
          } else {
            const direction = dy < 0 ? -1 : 1;
            a.y -= direction * overlapY * .52;
            b.y += direction * overlapY * .48;
            const relative = (b.vy - a.vy) * direction;
            if (relative < 0) { const impulse = -(1.3 * relative) / 2; a.vy -= impulse * direction; b.vy += impulse * direction; }
          }
        }
      }

      draw(now / 1000);
      frame = requestAnimationFrame(step);
    };

    const start = () => {
      if (frame || reduceMotion) return;
      visible = true;
      lastFrame = 0;
      frame = requestAnimationFrame(step);
    };

    const stop = () => {
      visible = false;
      cancelAnimationFrame(frame);
      frame = 0;
      window.clearTimeout(idleTimer);
    };

    const scheduleIdleBounce = () => {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        if (visible && !dragging) {
          const tag = tags[Math.floor(Math.random() * tags.length)];
          if (tag) {
            const direction = Math.random() < .5 ? -1 : 1;
            tag.vx = direction * (260 + Math.random() * 140);
            tag.vy = -(650 + Math.random() * 120);
            tag.spin += direction * (2 + Math.random() * 2);
          }
        }
        scheduleIdleBounce();
      }, 2600 + Math.random() * 2000);
    };

    const localPoint = (event: PointerEvent) => {
      const bounds = canvas.getBoundingClientRect();
      return { x: event.clientX - bounds.left, y: event.clientY - bounds.top };
    };

    const hitTest = (x: number, y: number) => [...tags].reverse().find((tag) => {
      const dx = x - tag.x;
      const dy = y - tag.y;
      const localX = dx * Math.cos(tag.angle) + dy * Math.sin(tag.angle);
      const localY = -dx * Math.sin(tag.angle) + dy * Math.cos(tag.angle);
      return Math.abs(localX) <= tag.width / 2 && Math.abs(localY) <= tag.height / 2;
    });

    canvas.addEventListener('pointerdown', (event) => {
      if (reduceMotion) return;
      const point = localPoint(event);
      pointer.x = pointer.lastX = point.x;
      pointer.y = pointer.lastY = point.y;
      pointer.lastTime = performance.now();
      dragging = hitTest(point.x, point.y) ?? null;
      if (dragging) {
        dragging.dragging = true;
        pointer.offsetX = dragging.x - point.x;
        pointer.offsetY = dragging.y - point.y;
        canvas.setPointerCapture(event.pointerId);
        stage.classList.add('is-grabbing');
      } else {
        tags.forEach((tag) => {
          const dx = tag.x - point.x;
          const dy = tag.y - point.y;
          const distance = Math.hypot(dx, dy);
          if (distance > 300) return;
          const force = (1 - distance / 300) * 620;
          const angle = Math.atan2(dy - 70, dx);
          tag.vx += Math.cos(angle) * force;
          tag.vy += Math.sin(angle) * force;
          tag.spin += (Math.random() - .5) * 5;
        });
      }
    });

    canvas.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const point = localPoint(event);
      const now = performance.now();
      const elapsed = Math.max(.008, (now - pointer.lastTime) / 1000);
      dragging.x = point.x + pointer.offsetX;
      dragging.y = point.y + pointer.offsetY;
      dragging.vx = Math.max(-1400, Math.min(1400, (point.x - pointer.lastX) / elapsed));
      dragging.vy = Math.max(-1400, Math.min(1400, (point.y - pointer.lastY) / elapsed));
      dragging.spin = Math.max(-5, Math.min(5, ((point.x - pointer.lastX) - (point.y - pointer.lastY) * .35) / elapsed * .004));
      pointer.lastX = point.x;
      pointer.lastY = point.y;
      pointer.lastTime = now;
    });

    const release = () => {
      if (dragging) dragging.dragging = false;
      dragging = null;
      stage.classList.remove('is-grabbing');
    };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    window.addEventListener('resize', resize, { passive: true });
    resize();

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { start(); scheduleIdleBounce(); }
      else stop();
    }, { threshold: .05 });
    visibilityObserver.observe(stage);
    document.fonts?.ready.then(resize);

    if (crosshairPointer.matches && crosshairLayer && coordinateReadout) {
      stage.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse') return;
        const bounds = stage.getBoundingClientRect();
        const x = Math.max(0, Math.min(bounds.width, event.clientX - bounds.left));
        const y = Math.max(0, Math.min(bounds.height, event.clientY - bounds.top));
        const xCoordinate = Math.round((x / bounds.width) * 1920).toString().padStart(4, '0');
        const yCoordinate = Math.round((y / bounds.height) * 1080).toString().padStart(4, '0');
        const labelX = Math.max(10, Math.min(bounds.width - coordinateReadout.offsetWidth - 10, x + 18));
        const labelY = Math.max(10, Math.min(bounds.height - coordinateReadout.offsetHeight - 10, y + 18));

        crosshairLayer.style.setProperty('--crosshair-x', `${x}px`);
        crosshairLayer.style.setProperty('--crosshair-y', `${y}px`);
        coordinateReadout.style.transform = `translate3d(${labelX}px, ${labelY}px, 0)`;
        coordinateReadout.textContent = `X ${xCoordinate}  Y ${yCoordinate}`;
        stage.classList.add('is-crosshair-active');
        document.body.classList.add('is-crosshair-zone');
      }, { passive: true });
      stage.addEventListener('pointerleave', () => {
        stage.classList.remove('is-crosshair-active');
        document.body.classList.remove('is-crosshair-zone');
      });
    }
  });
</script>
