---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = '好聚設計｜聚焦品牌視覺，讓好印象聚在一起',
  description = '好聚設計整合電商、社群與多元視覺設計，展現品牌質感與特色，建立一致的品牌形象。',
} = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3eee5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-scroll-reveal]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const repeatRevealOnDesktop = window.matchMedia('(min-width: 641px)').matches;

      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              if (!repeatRevealOnDesktop) observer.unobserve(entry.target);
            } else if (repeatRevealOnDesktop) {
              entry.target.classList.remove('is-visible');
            }
          });
        }, { threshold: repeatRevealOnDesktop ? 0.01 : 0.12, rootMargin: '0px' });

        revealTargets.forEach((target) => {
          target.classList.add('scroll-reveal');
          revealObserver.observe(target);
        });
      }
    </script>
  </body>
</html>
